{
  "name": "@rollforge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts src/server.ts --format esm --dts --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@node-rs/argon2": "^2.0.2",
    "@rollforge/extension-api": "workspace:*",
    "@rollforge/protocol": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "semver": "^7.6.3",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.8",
    "@types/uuid": "^10.0.0",
    "socket.io-client": "^4.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.0"
  }
}